# URL pública final do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial em formato internacional, só dígitos (ex.: 55 + DDD + número). Obrigatório para ativar o CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Agendamento (Supabase) — SOMENTE no servidor; nunca com prefixo NEXT_PUBLIC_ ---
# Settings > API do projeto Supabase. A service_role dá acesso total: não compartilhar nem commitar.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Painel do técnico (login por link no e-mail; lista de e-mails autorizados, separados por vírgula) ---
# ADMIN_ALLOWED_EMAILS=
