# URL pública final do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial em formato internacional, só dígitos (ex.: 55 + DDD + número). Obrigatório para ativar o CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Agendamento (Postgres) — SOMENTE no servidor; nunca com prefixo NEXT_PUBLIC_ ---
# String de conexão do Postgres (Supabase: Project Settings > Database > Connection string > "Transaction pooler").
# Serve também para Neon ou qualquer Postgres. Contém a senha: guardar só na Vercel, nunca em chat ou commit.
# DATABASE_URL=

# --- Painel do técnico (senha única) — SOMENTE no servidor ---
# Mínimo de 14 caracteres (use frase longa ou gerador de senhas). Sem ela o acesso fica desativado.
# TECH_PASSWORD=

# --- Avisos de pedido novo no celular do técnico (Web Push) — SOMENTE no servidor ---
# Gerar as chaves no painel (/admin, "Gerar chaves") e cadastrar aqui como Secret. Sem elas, os avisos ficam desativados.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Limpeza automática de dados antigos (LGPD) — chamada diária pelo agendador da Vercel ---
# Uma frase/código longo (mínimo 16 caracteres). Sem ele, a rota de limpeza fica desativada.
# CRON_SECRET=
